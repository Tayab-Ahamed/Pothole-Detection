*.pt
*.onnx
*.engine
*.trt

# ── Runtime directories ──────────────────────────
uploads/
outputs/
runs/          # YOLOv8 training artefacts

# ── Data ─────────────────────────────────────────
data/          # training images / labels — too large for git

# ── OS artefacts ─────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Jupyter ──────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs & temp ──────────────────────────────────
*.log
*.tmp
*.bak

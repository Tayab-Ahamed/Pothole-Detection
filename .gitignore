# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────────────
.venv/
venv/
env/
ENV/

# ── Model weights (large binaries) ──────────────
